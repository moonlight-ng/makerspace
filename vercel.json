{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "crons": [
    {
      "path": "/api/cron/sync-notion",
      "schedule": "* * * * *"
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "30ajasa.com"
        }
      ],
      "headers": {
        "Cache-Control": "public, max-age=0, must-revalidate",
        "X-Robots-Tag": "noindex, nofollow, noarchive"
      },
      "status": 410
    },
    {
      "src": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "www.30ajasa.com"
        }
      ],
      "headers": {
        "Cache-Control": "public, max-age=0, must-revalidate",
        "X-Robots-Tag": "noindex, nofollow, noarchive"
      },
      "status": 410
    }
  ],
  "headers": [
    {
      "source": "/studio",
      "headers": [
        { "key": "Cache-Control", "value": "private, no-store, max-age=0" },
        { "key": "X-Robots-Tag", "value": "noindex, nofollow, noarchive" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "no-referrer" }
      ]
    },
    {
      "source": "/studio/",
      "headers": [
        { "key": "Cache-Control", "value": "private, no-store, max-age=0" },
        { "key": "X-Robots-Tag", "value": "noindex, nofollow, noarchive" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "no-referrer" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/building", "destination": "/pages/building/index.html" },
    { "source": "/building/", "destination": "/pages/building/index.html" },
    { "source": "/contact", "destination": "/pages/contact/index.html" },
    { "source": "/contact/", "destination": "/pages/contact/index.html" },
    { "source": "/film-club", "destination": "/pages/film-club/index.html" },
    { "source": "/film-club/", "destination": "/pages/film-club/index.html" },
    { "source": "/makerspace", "destination": "/pages/makerspace/index.html" },
    { "source": "/makerspace/", "destination": "/pages/makerspace/index.html" },
    { "source": "/payment-complete", "destination": "/pages/payment-complete/index.html" },
    { "source": "/payment-complete/", "destination": "/pages/payment-complete/index.html" },
    { "source": "/studio", "destination": "/pages/studio/index.html" },
    { "source": "/studio/", "destination": "/pages/studio/index.html" }
  ]
}
